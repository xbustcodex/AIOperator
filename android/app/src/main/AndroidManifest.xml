<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Buster is a separate Android application and a separate security
      principal from Prime Tech Terminal (com.primetechterminal) and TerminalP
      (com.primetech.terminal). It holds no storage, network or root permission
      of its own: every privileged interaction goes through the authenticated
      TerminalP bridge, and all document exchange is user-mediated via the
      system picker. INTERNET is deliberately NOT requested.
    -->

    <application
        android:name=".BusterApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buster">

        <activity
            android:name=".ui.BusterActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Buster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
